# Defeitos intencionais ligados ao iniciar (lista de 1 a 7 separada por vírgula).
# Vazio = todos desligados (padrão).
RETALHO_BUGS=

# Libera a área /qa/defeitos mesmo com NODE_ENV=production (ex.: E2E com `next start`).
# Fora de produção a área já fica liberada.
RETALHO_QA_PAINEL=

# Caminho do banco SQLite local (gerado pelo seed; nunca versionado).
RETALHO_DB_PATH=data/retalho.db
